#!/usr/bin/env bash
# create-blocker: open a blocking issue (optionally cross-repo in arbsec/orchestraitor)
# and link it from the current Arbitraitor issue via a blockedBy edge.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

arb_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  arb_lib_print_help "create-blocker" "Open a blocking issue (optionally in arbsec/orchestraitor) and link it from the current issue."
  exit "$ARB_OK"
fi

# Single parse loop: consume flags and positionals from extra args.
BLOCKED_ISSUE=""
TITLE=""
while [ "${#ARB_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ARB_LIB_EXTRA_ARGS[0]}" in
    --blocked-issue) BLOCKED_ISSUE="${ARB_LIB_EXTRA_ARGS[1]:-}"; ARB_LIB_EXTRA_ARGS=("${ARB_LIB_EXTRA_ARGS[@]:2}") ;;
    --title)         TITLE="${ARB_LIB_EXTRA_ARGS[1]:-}"; ARB_LIB_EXTRA_ARGS=("${ARB_LIB_EXTRA_ARGS[@]:2}") ;;
    *) break ;;
  esac
done
[ -z "$BLOCKED_ISSUE" ] && BLOCKED_ISSUE="${ARB_LIB_EXTRA_ARGS[0]:-}"
[ -z "$TITLE" ] && TITLE="${ARB_LIB_EXTRA_ARGS[1]:-}"

if [ -z "$BLOCKED_ISSUE" ] || [ -z "$TITLE" ]; then
  echo "error: --blocked-issue <num> and --title <text> required" >&2
  echo "  If the blocker is cross-repo (Orchestraitor), pass --repo arbsec/orchestraitor." >&2
  exit "$ARB_ERR_CONFIG"
fi

arb_lib_require_gh_scope
arb_lib_load_project_config

# The blocked issue lives in this repo (from --repo or the gh default).
# The blocker issue is created in TARGET_REPO: the same repo by default, or
# the cross-repo sibling via --repo arbsec/orchestraitor. Identity is never
# guessed: --repo, or repo resolution that fails loudly.
HOME_REPO="$(arb_lib_resolve_repo)"

# --repo targets the blocker repo. Same-repo when it equals HOME_REPO, or when
# not passed. Positional cross-repo input is rejected — use the flag.
TARGET_REPO="${OPT_REPO:-$HOME_REPO}"

IS_CROSS_REPO="$([ "$TARGET_REPO" != "$HOME_REPO" ] && echo true || echo false)"

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh issue create --repo $TARGET_REPO --title \"$TITLE\"$( [ "$IS_CROSS_REPO" = true ] && echo ' --label blocked:orchestraitor')" >&2
  echo "[dry-run] gh issue edit $BLOCKED_ISSUE --repo $HOME_REPO --add-blocked-by <new-num>" >&2
  exit "$ARB_OK"
fi

# Create the blocker issue. Label only cross-repo blockers: blocked:orchestraitor
# means "blocked ON orchestraitor" and is wrong for same-repo blockers.
if [ "$IS_CROSS_REPO" = true ]; then
  ARGS=(issue create --repo "$TARGET_REPO" --title "$TITLE" --label "blocked:orchestraitor")
else
  ARGS=(issue create --repo "$TARGET_REPO" --title "$TITLE")
fi
BLOCKER_URL="$(arb_lib_run_or_dry_run ARGS gh)"
echo "Created blocker: $BLOCKER_URL" >&2
BLOCKER_NUM="$(echo "$BLOCKER_URL" | grep -oE '[0-9]+$')"

# Link via native blockedBy (same repo).
if [ "$IS_CROSS_REPO" = false ]; then
  ARGS=(issue edit "$BLOCKED_ISSUE" --repo "$HOME_REPO" --add-blocked-by "$BLOCKER_NUM")
  arb_lib_run_or_dry_run ARGS gh
  echo "Linked blockedBy edge: $BLOCKED_ISSUE -> #$BLOCKER_NUM" >&2
  exit "$ARB_OK"
fi

# Cross-repo: use GraphQL addBlockedBy (node IDs are cross-repo within an org).
BLOCKER_ID="$(arb_lib_gh issue view "$BLOCKER_NUM" --repo "$TARGET_REPO" --json id -q '.id')"
BLOCKED_ID="$(arb_lib_gh issue view "$BLOCKED_ISSUE" --repo "$HOME_REPO" --json id -q '.id')"
if ! arb_lib_gh api graphql \
    -f query="mutation { addBlockedBy(input: {issueId: \"$BLOCKED_ID\", blockingIssueId: \"$BLOCKER_ID\"}) { issue { number } blockingIssue { number } } }" >/dev/null; then
  # Fail loudly: without the edge the issue is NOT excluded from the ready
  # queue, which defeats the "do not retry a blocked Task" policy. Never
  # leave a silent gap behind a printed instruction.
  echo "error: GraphQL addBlockedBy failed — the blockedBy edge does NOT exist and issue $BLOCKED_ISSUE remains schedulable." >&2
  echo "  Manually run: gh issue edit $BLOCKED_ISSUE --repo $HOME_REPO --add-blocked-by <num>, or link 'Blocked by $BLOCKER_URL' in the issue body, then re-run." >&2
  exit "$ARB_ERR_UNRECOVERABLE"
fi
echo "Cross-repo blockedBy edge created: arbsec/orchestraitor#$BLOCKER_NUM blocks $BLOCKED_ISSUE (label: blocked:orchestraitor)." >&2
