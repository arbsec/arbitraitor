#!/usr/bin/env bash
# ready-queue: list issues that are eligible for implementation.
# Eligible = leaf Type (Task/Bug), no unresolved blockedBy, and every assignee
# is a declared service identity (see .agents/project/arbitraitor-workflow.md).
# If $ARB_MVP_LABEL is set, issues must also carry that label.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

arb_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  arb_lib_print_help "ready-queue" "List ready leaf issues (Type=Task/Bug, no unresolved blockers, no human assignees; optional label gate via ARB_MVP_LABEL)."
  exit "$ARB_OK"
fi

arb_lib_require_gh_scope
arb_lib_load_project_config
REPO="$(arb_lib_resolve_repo)"

# --- Service identities for the assignee exclusion (spec §9.41) --------------
# Items assigned to humans are excluded; items assigned to a declared service
# identity (the GitHub App bot) stay schedulable. Precedence:
# $ARB_SERVICE_IDENTITIES (comma-separated) > [service_identities].slugs in the
# project config > built-in default "arbsec-agent".
SERVICE_SLUGS="${ARB_SERVICE_IDENTITIES:-}"
if [ -z "$SERVICE_SLUGS" ]; then
  SERVICE_SLUGS="$(awk '
    /^\[service_identities\]/ { in_section = 1; next }
    /^\[/ { in_section = 0 }
    in_section && /^[[:space:]]*slugs[[:space:]]*=/ {
      line = $0
      sub(/^[^=]*=[[:space:]]*/, "", line)
      gsub(/[][ \t"]/, "", line)
      print line
      exit
    }' "$ARB_PROJECT_CONFIG")"
fi
SERVICE_SLUGS="${SERVICE_SLUGS:-arbsec-agent}"
SERVICE_JSON="$(printf '%s' "$SERVICE_SLUGS" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d' | jq -R . | jq -s .)"

# Fetch open issues with the fields we need for filtering.
# gh issue list --json returns blockedBy/subIssues as {nodes:[...],totalCount:N}.
#
# LIMITATION: gh issue list does NOT return Project v2 field values (Target, Status, Risk).
# This script filters on issueType + blockedBy + an MVP label as a proxy. A future
# version will use gh project item-list to read Status=Ready and Target=MVP directly.
# Until then, the project-manager must verify Status=Ready before claiming.
ISSUES_JSON="$(arb_lib_gh issue list --repo "$REPO" --state open --limit 200 \
  --json number,title,issueType,labels,assignees,blockedBy,subIssues,url)"

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh issue list --repo $REPO --state open --limit 200 --json ..." >&2
  exit "$ARB_OK"
fi

# Filter with jq (program lives in ready-queue.jq so it is regression-tested):
# - leaf iff issueType.name in ["Task","Bug"] OR labels contain task/bug
#   (org-level native types are unset; see [issue_types] in github-project.example.toml)
# - no blockedBy node with state != "CLOSED" (totalCount counts resolved blockers too)
# - has the MVP label (proxy for Target=MVP until Project field reads are implemented)
#
# The project-manager MUST verify Status=Ready before claiming — this script cannot
# read Project v2 field values yet.
#
# Optional label gate: ARB_MVP_LABEL is empty by default (arbitraitor is a
# post-MVP project — scheduling runs on the P0/P1 auto-continuation queue in
# .agents/project/arbitraitor-workflow.md, not on an MVP target). Set it to a
# label name to require that label on every queued issue.
MVP_LABEL="${ARB_MVP_LABEL:-}"

FILTERED="$(echo "$ISSUES_JSON" | jq --arg mvp "$MVP_LABEL" --argjson service "$SERVICE_JSON" -f "$SCRIPT_DIR/ready-queue.jq")"

COUNT="$(echo "$FILTERED" | jq 'length')"

if [ "$OPT_JSON" = true ]; then
  echo "$FILTERED"
else
  echo "Ready queue ($COUNT eligible issue(s)):"
  echo "$FILTERED" | jq -r '.[] | "  #\(.number): \(.title)"'
fi
