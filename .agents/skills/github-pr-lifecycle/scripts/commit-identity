#!/usr/bin/env bash
# commit-identity: verify the ambient git commit identity in a worktree or
# clone before any local `git commit` destined for a PR branch.
#
# Arbitraitor's commit shape (arbitraitor-workflow.md "GitHub service identity",
# verified live on PRs #776/#780/#801): commits are **authored** as the
# `arbsec-agent[bot]` service principal with a DCO `Signed-off-by:` trailer,
# while the **committer** stays the operator's ambient local identity — the
# bot owns no signing key, and the org ruleset (`required_signatures`) verifies
# SSH signatures against keys registered to the *committer's* identity.
# (The landing path itself is `xtask push-branch`, which creates the remote
# commit via the App API — committer `GitHub <noreply@github.com>`, signed by
# GitHub. This check governs LOCAL commits, e.g. multi-commit chains that will
# be landed tree-identically or audit-logged branch history.)
#
# Incident background: a fresh clone/worktree inherits the global gitconfig
# (user.name=mekwall / user.email=marcus.ekwall@gmail.com). A local commit made
# there as the OPERATOR is correct-by-design here (committer=operator is the
# verified shape), but a commit authored as the human (no `--author=` override)
# produces PR history attributed to the personal account — a policy violation.
#
# Subcommands:
#   check [path] [--author "Name <email>"]
#                  Verify the AUTHOR identity a local commit would get:
#                  with --author, validate the explicitly planned author (the
#                  `git commit --author=...` value) against the bot author;
#                  without it, validate the ambient identity (GIT_AUTHOR_* env,
#                  else user.name/user.email). Also verify the COMMITTER
#                  identity is NOT the bot (the committer must stay the
#                  operator — `git -c user.name=<bot> commit` is forbidden).
#                  Commits without the bot author fail with exit 3 and a
#                  remediation hint. The DCO trailer is reported as a
#                  CONVENTION HINT, not a verification: in a repo with no
#                  commits yet the check is skipped (the caller is expected to
#                  pass `-s`), not failed.
#   env            Print the author override for `eval` (read-only; no secrets).
#
# Usage (agents): before ANY local `git commit` destined for a PR branch:
#   bash .agents/skills/github-pr-lifecycle/scripts/commit-identity check
#   bash .agents/skills/github-pr-lifecycle/scripts/commit-identity check . --author "Name <email>"
#   git commit --author="$ARBITRAITOR_BOT_AUTHOR" -s -m "..."
#
# Exit codes: 0 ok | 2 config/state error | 3 policy violation
set -euo pipefail

# Declared service principal (AGENTS.md / arbitraitor-workflow.md; matches
# xtask/src/github_mint.rs APP constants — do not hardcode divergent values).
BOT_NAME="arbsec-agent[bot]"
BOT_EMAIL="334074867+arbsec-agent[bot]@users.noreply.github.com"
BOT_AUTHOR="$BOT_NAME <$BOT_EMAIL>"

SUBCOMMAND="${1:-}"
case "$SUBCOMMAND" in
  env)
    printf 'export ARBITRAITOR_BOT_AUTHOR=%q\n' "$BOT_AUTHOR"
    exit 0
    ;;
  check)
    shift
    TARGET_PATH=""
    PLANNED_AUTHOR=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --author)
          if [ $# -lt 2 ]; then
            echo "error: --author requires a value (\"Name <email>\")" >&2
            exit 2
          fi
          PLANNED_AUTHOR="$2"
          shift 2
          ;;
        --author=*)
          PLANNED_AUTHOR="${1#--author=}"
          shift
          ;;
        *)
          if [ -z "$TARGET_PATH" ]; then
            TARGET_PATH="$1"
          else
            echo "error: unexpected argument: $1" >&2
            exit 2
          fi
          shift
          ;;
      esac
    done
    TARGET_PATH="${TARGET_PATH:-$PWD}"
    if [ ! -d "$TARGET_PATH" ]; then
      echo "error: path does not exist or is not a directory: $TARGET_PATH" >&2
      exit 2
    fi
    TOP="$(git -C "$TARGET_PATH" rev-parse --show-toplevel 2>/dev/null)" || {
      echo "error: not a git repository (or worktree): $TARGET_PATH" >&2
      exit 2
    }
    # A plain `git commit` takes the author from GIT_AUTHOR_* env first, then
    # user.name/user.email config. Evaluate exactly what the commit would use.
    AMBIENT_NAME="${GIT_AUTHOR_NAME:-$(git -C "$TOP" config user.name 2>/dev/null || true)}"
    AMBIENT_EMAIL="${GIT_AUTHOR_EMAIL:-$(git -C "$TOP" config user.email 2>/dev/null || true)}"
    # A plain `git commit` takes the committer from GIT_COMMITTER_* env first,
    # then user.name/user.email config. The committer must stay the OPERATOR
    # identity: the ruleset verifies signatures against the committer's keys,
    # and the bot owns no signing key, so `-c user.name=<bot>` produces a
    # commit that can never verify.
    COMMITTER_NAME="${GIT_COMMITTER_NAME:-$(git -C "$TOP" config user.name 2>/dev/null || true)}"
    COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$(git -C "$TOP" config user.email 2>/dev/null || true)}"
    DCO_HINT="unknown"
    if [ -n "${GIT_AUTHOR_NAME:-}" ] || git -C "$TOP" config user.name >/dev/null 2>&1; then
      # DCO is a convention hint, NOT a verification: the caller is expected
      # to pass `-s`. Check the marker (set by wrappers that always pass -s)
      # or the last commit's trailer; a repo with NO commits yet has no
      # convention to observe, so the hint is skipped, never failed.
      if [ "${ARBITRAITOR_DCO_OK:-}" = "1" ]; then
        DCO_HINT="ok (caller marker)"
      elif ! git -C "$TOP" rev-parse -q --verify HEAD >/dev/null 2>&1; then
        DCO_HINT="skipped (no commits yet; pass -s)"
      elif git -C "$TOP" log -1 --format='%(trailers:key=Signed-off-by,valueonly)' 2>/dev/null | grep -q .; then
        DCO_HINT="ok (last commit carries the trailer)"
      else
        DCO_HINT="missing"
      fi
    fi

    MATCH=true
    REASON=""
    # A caller may plan `git commit --author="..."`: when --author is passed
    # here, validate THAT author (the identity the commit will actually get),
    # not the ambient config. The committer-must-not-be-bot check is kept
    # regardless — the committer always stays the operator identity.
    if [ -n "$PLANNED_AUTHOR" ]; then
      if [ "$PLANNED_AUTHOR" != "$BOT_AUTHOR" ]; then
        MATCH=false
        REASON="planned --author '$PLANNED_AUTHOR' is not the service principal $BOT_AUTHOR"
      fi
      AUTHOR_LABEL="planned: $PLANNED_AUTHOR"
    elif [ -z "$AMBIENT_NAME" ] || [ -z "$AMBIENT_EMAIL" ]; then
      MATCH=false
      REASON="no user.name/user.email configured (and no GIT_AUTHOR_* env)"
      AUTHOR_LABEL="ambient: ${AMBIENT_NAME:-<unset>} <${AMBIENT_EMAIL:-<unset>}>"
    elif [ "$AMBIENT_NAME" != "$BOT_NAME" ] || [ "$AMBIENT_EMAIL" != "$BOT_EMAIL" ]; then
      # The operator identity is EXPECTED as the committer; it is a violation
      # only as the AUTHOR (no --author= override was passed).
      MATCH=false
      REASON="commits must be authored as $BOT_AUTHOR (pass --author=...); the ambient identity is reserved for the committer"
      AUTHOR_LABEL="ambient: $AMBIENT_NAME <$AMBIENT_EMAIL>"
    else
      AUTHOR_LABEL="ambient: $AMBIENT_NAME <$AMBIENT_EMAIL>"
    fi
    if [ "$COMMITTER_NAME" = "$BOT_NAME" ] || [ "$COMMITTER_EMAIL" = "$BOT_EMAIL" ]; then
      # The committer must NEVER be the bot: that identity has no registered
      # signing key, so the commit can never verify (required_signatures).
      MATCH=false
      REASON="the COMMITTER must stay the operator identity — never commit with -c user.name=$BOT_NAME (the bot owns no signing key; the commit could never verify)"
    fi

    echo "path:      $TOP"
    echo "author:    $AUTHOR_LABEL"
    echo "committer: ${COMMITTER_NAME:-<unset>} <${COMMITTER_EMAIL:-<unset>}>"
    echo "dco-hint:  $DCO_HINT (convention hint, not a verification; the commit command must carry -s)"
    if [ "$MATCH" = true ]; then
      echo "result:    OK (author is the service principal; committer stays ambient)"
    else
      echo "result:    POLICY VIOLATION — $REASON"
      echo "" >&2
      echo "remediation: author PR-branch commits as the service principal with DCO:" >&2
      echo "  git commit --author='$BOT_AUTHOR' -s -m \"...\"" >&2
      echo "or: eval \"\$(bash $0 env)\" && git commit --author=\"\$ARBITRAITOR_BOT_AUTHOR\" -s -m \"...\"" >&2
      echo "verify the planned command first: bash $0 check . --author \"\$ARBITRAITOR_BOT_AUTHOR\"" >&2
      echo "NOTE: the committer must stay the operator identity (never -c user.name=<bot>)." >&2
      echo "Land the branch with: cargo run -p xtask -- push-branch --message ... (App-signed)." >&2
      exit 3
    fi
    exit 0
    ;;
  *)
    echo "error: subcommand required (check [path] [--author \"Name <email>\"] | env)" >&2
    exit 2
    ;;
esac
