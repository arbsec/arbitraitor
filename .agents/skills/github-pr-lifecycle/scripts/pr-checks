#!/usr/bin/env bash
# pr-checks: read CI check status, classify each as pass/fail/pending/skip, and
# enforce the [checks].required list from the project config — a required check
# absent from the rollup is a failure unless its workflow is path-gated and the
# PR diff matches none of its paths.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

arb_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  arb_lib_print_help "pr-checks" "Read PR CI checks, classify each, and enforce the required-check list. Missing required checks fail."
  exit "$ARB_OK"
fi

PR="${ARB_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number or URL required" >&2
  exit "$ARB_ERR_CONFIG"
fi

arb_lib_require_gh_scope
arb_lib_load_project_config
REPO="$(arb_lib_resolve_repo)"

CHECK_ARGS=(pr checks "$PR" --repo "$REPO" --json "name,state,bucket,workflow,link,startedAt,completedAt")

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${CHECK_ARGS[*]}" >&2
  echo "[dry-run] gh pr diff $PR --repo $REPO --name-only" >&2
  exit "$ARB_OK"
fi

RAW="$(arb_lib_gh "${CHECK_ARGS[@]}")" || EXIT_CODE=$?

# gh pr checks exits 8 when pending; capture the JSON regardless.
EXIT_CODE=${EXIT_CODE:-0}
if [ -z "$RAW" ] && [ "$EXIT_CODE" -eq 8 ]; then
  echo '{"checks":[],"all_passed":false,"any_pending":true,"any_failing":false,"missing_required":[]}'
  exit 0
fi
if [ -z "$RAW" ]; then
  # Hard gh failure (auth, network, PR not found): fail loudly — exit-code
  # contract says 0 = success, and empty output must never masquerade as one.
  echo "error: gh pr checks failed (exit $EXIT_CODE) and produced no output" >&2
  exit "$ARB_ERR_UNRECOVERABLE"
fi

# --- Required / optional check lists from the project config -------------------
read_checks_field() {
  local field="$1" file="${2:-$ARB_PROJECT_CONFIG}"
  awk -v field="$field" '
    function emit(s,   i, n, part) {
      n = split(s, part, ",")
      for (i = 1; i <= n; i++) {
        gsub(/"/, "", part[i])
        sub(/^[[:space:]]+/, "", part[i]); sub(/[[:space:]]+$/, "", part[i])
        if (part[i] != "") print part[i]
      }
    }
    /^[[:space:]]*\[checks\][[:space:]]*$/ { insec = 1; next }
    /^[[:space:]]*\[/ { insec = 0 }
    insec && multi {
      line = $0
      if (line ~ /\]/) { sub(/\].*$/, "", line); emit(line); exit }
      emit(line)
      next
    }
    insec && $0 ~ field "[[:space:]]*=" {
      line = $0; sub(/^[^=]*=[[:space:]]*/, "", line)
      sub(/\[/, "", line)
      if (line ~ /\]/) { sub(/\].*$/, "", line); emit(line); exit }
      emit(line); multi = 1
    }
  ' "$file"
}
to_json_array() {
  jq -R . | jq -s .
}
REQUIRED_JSON="$(read_checks_field required | to_json_array)"
OPTIONAL_JSON="$(read_checks_field optional | to_json_array)"
if [ "$(echo "$REQUIRED_JSON" | jq 'length')" -eq 0 ]; then
  echo "error: [checks].required is empty or missing in $ARB_PROJECT_CONFIG — cannot enforce the required-check list" >&2
  exit "$ARB_ERR_CONFIG"
fi

# --- Local-vs-example config drift (arbsec/arbitraitor#868) --------------------
# The gate enforces [checks].required from the gitignored local config, which no
# `git pull` updates. A local config that predates a change to the example's
# required list silently narrows the gate: `missing_required` is derived from
# `required` alone, so an entry dropped from it can never be reported missing —
# and a required check whose workflow produced NO rollup entry at all would pass.
# Report only the direction that narrows the gate (example-required minus
# local-required); a local config that ADDS a required check is a local policy
# choice, not drift. stderr only, and never fatal: every consumer of stdout (the
# JSON verdict, and therefore `merge-gate`) must be byte-identical with and
# without drift. Failing on drift would resurrect the "blocked until hand-edited"
# deadlock class that the PATH_GATED table exists to avoid (#862).
if [ -n "${ARB_PROJECT_CONFIG_EXAMPLE:-}" ] &&
   [ "$ARB_PROJECT_CONFIG" != "$ARB_PROJECT_CONFIG_EXAMPLE" ] &&
   [ -f "$ARB_PROJECT_CONFIG_EXAMPLE" ]; then
  # Materialise both lists before comparing: a failure inside `<(...)` cannot
  # reach the `||` on the command substitution, so a broken `read_checks_field`,
  # `jq` or `sort` would leave `comm` comparing partial input — reporting wrong
  # drift or none, with no way to tell that apart from "no drift". With `set -e`
  # + `pipefail` a failing stage fails the assignment, and the `||` turns that
  # into "nothing to report": the degradation the "never fatal" contract above
  # requires. `|| DRIFT=""` on the `comm` is load-bearing for the same reason at
  # :6 — a failing `comm` must not abort the gate. An empty example `required`
  # list skips the comparison instead of warning about an empty check name.
  example_required="$(read_checks_field required "$ARB_PROJECT_CONFIG_EXAMPLE" | sort -u)" || example_required=""
  local_required="$(printf '%s\n' "$REQUIRED_JSON" | jq -r '.[]' | sort -u)" || local_required=""
  DRIFT=""
  if [ -n "$example_required" ]; then
    DRIFT="$(comm -23 \
      <(printf '%s\n' "$example_required") \
      <(printf '%s\n' "$local_required"))" || DRIFT=""
  fi
  if [ -n "$DRIFT" ]; then
    printf 'warning: local project config %s drops required checks the example declares: %s\n' \
      "$ARB_PROJECT_CONFIG" \
      "$(printf '%s\n' "$DRIFT" | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')" >&2
    printf '         re-sync [checks].required from %s (arbsec/arbitraitor#868) — a dropped\n' \
      "$ARB_PROJECT_CONFIG_EXAMPLE" >&2
    printf '         required check cannot be reported missing by this gate.\n' >&2
  fi
fi

# --- PR diff paths (fail loudly — an unreadable diff must not become "no paths")
FILES_JSON="$(arb_lib_gh pr diff "$PR" --repo "$REPO" --name-only | jq -R -s 'split("\n") | map(select(length > 0))')"

# --- Path-gated required checks ------------------------------------------------
# Mirror of the `on.pull_request.paths` filters in the workflow files: a
# path-gated check legitimately never reports when the diff matches none of
# its paths. KEEP IN SYNC with
# .github/workflows/{code,markdown,invariants,security,agents}.yml.
# CodeQL Analysis has no entry: its workflow is unfiltered.
# `Agent Skills Tests` is the agents.yml job — the single home for the agent
# skill shell gate. Its PATH_GATED row mirrors agents.yml's trigger paths
# (`.agents/**`, `.github/workflows/agents.yml`, `.shellcheckrc`,
# `.github/workflows/**`), so the suites are required exactly for the diffs
# that trigger agents.yml and exempt for every other diff. A required check
# with no row is never exempt: when it is absent from the rollup it is
# recorded in `missing_required` and blocks the gate. The failure mode in this
# area is the reverse — a check omitted from `[checks].required` can never be
# reported missing (that list is derived from `required` alone), so an
# `.agents/**` diff whose suites were not required would pass the gate.
# `.github/workflows/**` is in the row because the suites assert the
# PATH_GATED table against every workflow file, so a workflow-file diff can
# invalidate that table and must run the suites.
# `.shellcheckrc` is path-gated because a `disable=`
# there silences rules for every script — and qlty's shellcheck plugin lists a
# repo-root `.shellcheckrc` in its `config_files`, so it weakens both gates.
# The two shellcheck gates have different severity floors: the workflow runs
# `-S warning`, qlty runs shellcheck at its default (info included) on changed
# lines, so qlty is the stricter of the two and an info-level finding can block
# there while the workflow stays green.
PATH_GATED='[
  {"name": "Invariant Property Tests",
   "paths": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", ".mise.toml", ".github/workflows/invariants.yml"]},
  {"name": "Dependency Policy",
   "paths": ["**/Cargo.toml", "Cargo.lock", "deny.toml", ".mise.toml", ".github/workflows/security.yml"]},
  {"name": "Advisory Check",
   "paths": ["**/Cargo.toml", "Cargo.lock", "deny.toml", ".mise.toml", ".github/workflows/security.yml"]},
  {"name": "Check & Lint",
   "paths": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", ".mise.toml", ".github/workflows/code.yml", "wit/**", "**/*.wit", ".config/hakari.toml"]},
  {"name": "Workspace Hack (ubuntu-latest)",
   "paths": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", ".mise.toml", ".github/workflows/code.yml", "wit/**", "**/*.wit", ".config/hakari.toml"]},
  {"name": "Workspace Hack (macos-latest)",
   "paths": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", ".mise.toml", ".github/workflows/code.yml", "wit/**", "**/*.wit", ".config/hakari.toml"]},
  {"name": "Test (ubuntu-latest)",
   "paths": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", ".mise.toml", ".github/workflows/code.yml", "wit/**", "**/*.wit", ".config/hakari.toml"]},
  {"name": "Test (macos-latest)",
   "paths": ["**/*.rs", "**/Cargo.toml", "Cargo.lock", ".mise.toml", ".github/workflows/code.yml", "wit/**", "**/*.wit", ".config/hakari.toml"]},
  {"name": "Agent Skills Tests",
   "paths": [".agents/**", ".github/workflows/agents.yml", ".shellcheckrc", ".github/workflows/**"]},
  {"name": "Markdown Lint",
   "paths": ["**/*.md", "rumdl.toml", "lefthook.yml", ".mise.toml", ".github/workflows/markdown.yml"]},
  {"name": "Book Build",
   "paths": ["**/*.md", "rumdl.toml", "lefthook.yml", ".mise.toml", ".github/workflows/markdown.yml"]},
  {"name": "Docs Consistency",
   "paths": ["**/*.md", "rumdl.toml", "lefthook.yml", ".mise.toml", ".github/workflows/markdown.yml"]}
]'

# Is a required check exempt because its workflow is path-gated and no diff
# file matches any of its paths? (No path-gate entry → not exempt.)
#
# The glob translation MIRRORS GitHub Actions' `paths:` semantics, so it is
# anchored at both ends:
#
#   `**/`  -> `(.*/)?`   zero or more directories (matches a root file too)
#   `**`   -> `.*`       everything, including `/` (a trailing `dir/**`)
#   `*`    -> `[^/]*`    anything but `/`
#   `.`    -> `\.`
#
# Each form gets its own placeholder, because the single-`*` pass would
# otherwise rewrite the `*` that `**` expands to.
#
# Anchoring is required for the patterns with no `**/` prefix -- `Cargo.lock`,
# `.mise.toml`, `deny.toml`, `rumdl.toml`, `lefthook.yml` are ROOT-only in
# GitHub Actions. An unanchored regex would make `fuzz/Cargo.lock` match
# `Cargo.lock`, so the code.yml checks would be required for a diff that never
# starts the workflow, the checks would never report, and the gate would block
# forever with `missing_required` (fail-closed, but unrecoverable without
# editing the table). The `(.*/)?` form keeps `**/Cargo.toml` matching BOTH
# `Cargo.toml` and `fuzz/Cargo.toml`, as GitHub does.
path_gate_exempt() {
  local chk="$1"
  jq -rn --arg c "$chk" --argjson gated "$PATH_GATED" --argjson files "$FILES_JSON" '
    ([$gated[] | select(.name == $c) | .paths[]] | length) as $np
    | if $np == 0 then false
      else
        ([$gated[]
            | select(.name == $c)
            | .paths[] as $p
            | select(any($files[]; test("^" + ($p | gsub("\\."; "\u0001") | gsub("\\*\\*/"; "\u0002") | gsub("\\*\\*"; "\u0003") | gsub("\\*"; "[^/]*") | gsub("\u0002"; "(.*/)?") | gsub("\u0003"; ".*") | gsub("\u0001"; "\\.")) + "$"))
            )]
          | length) == 0
      end'
}

# --- Missing required checks (bash loop; fail closed) --------------------------
MISSING_REQUIRED="[]"
if [ "$(echo "$RAW" | jq 'length')" -gt 0 ]; then
  MISSING_LIST=""
  while IFS= read -r chk; do
    [ -z "$chk" ] && continue
    PRESENT="$(echo "$RAW" | jq -r --arg c "$chk" 'any(.[]; .name == $c)')"
    [ "$PRESENT" = "true" ] && continue
    if [ "$(path_gate_exempt "$chk")" = "true" ]; then continue; fi
    MISSING_LIST="${MISSING_LIST}${chk}\n"
  done < <(echo "$REQUIRED_JSON" | jq -r '.[]')
  MISSING_REQUIRED="$(printf '%b' "$MISSING_LIST" | sed '/^$/d' | jq -R . | jq -s 'map(select(length > 0))')"
fi

# --- Classification ------------------------------------------------------------
# Skipping-state exemption: workflow jobs deliberately disabled repo-side via
# `if:` conditions (state SKIPPED, conclusion skipped). The exemption requires
# BOTH the name AND the skipped state — a job that ran and failed is a failure,
# never a pass. "Documentation" is event-gated in code.yml
# (`if: github.event_name == 'push'`) and also listed in [checks].optional.
echo "$RAW" | jq \
  --argjson optional "$OPTIONAL_JSON" \
  --argjson missing_required "$MISSING_REQUIRED" '
  def exempt:
    .name as $n
    | (.bucket == "skipping")
    and (($optional | index($n)) != null);
  {
    checks: map({
      name: .name,
      state: .state,
      bucket: .bucket,
      workflow: .workflow,
      link: .link,
      classification: (
        if exempt then "not-applicable"
        elif .bucket == "pass" then "pass"
        elif .bucket == "fail" then "fail"
        elif .bucket == "pending" then "pending"
        elif .bucket == "skipping" then "skip"
        elif .bucket == "cancel" then "fail"
        else "unknown"
        end
      )
    }),
    missing_required: $missing_required,
    all_passed: (((length) > 0)
      and all(.[]; .bucket == "pass" or exempt)
      and (($missing_required | length) == 0)),
    any_failing: any(.[]; .bucket == "fail" or .bucket == "cancel"),
    any_pending: any(.[]; .bucket == "pending")
  }'
