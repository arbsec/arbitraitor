{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "schedule": ["before 5am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group patch updates for Cargo dependencies",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "groupName": "cargo-patch-updates",
      "automerge": true
    },
    {
      "description": "Group minor updates for Cargo dependencies",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor"],
      "groupName": "cargo-minor-updates"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Automerge GitHub Actions patch, digest, pin, and pinDigest updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Never automerge Actions in docs and release workflows (no pull_request trigger to validate them)",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/docs.yml",
        ".github/workflows/release.yml"
      ],
      "automerge": false
    },
    {
      "description": "Group all mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise-tools"
    },
    {
      "description": "Automerge mise tool patch, digest, and pin updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "groupName": "mise-tools",
      "automerge": true
    },
    {
      "description": "Never automerge Rust toolchain updates (conventions.md: pin changes require an ADR)",
      "matchManagers": ["mise"],
      "matchDepNames": ["rust"],
      "groupName": "mise-tools",
      "automerge": false
    }
  ]
}
